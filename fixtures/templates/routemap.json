{
  "schemaVersion": 3,
  "id": "routemap",
  "name": "Mapa",
  "description": "Track GPS con estela recorrida y punto actual.",
  "theme": {
    "text": "#ffffff",
    "accent": "#0099ff",
    "panel": "#0b0e11",
    "panelOpacity": 0
  },
  "widgets": [
    {
      "id": "track",
      "metric": "none",
      "kind": "map",
      "visible": true,
      "strokeWidth": 8,
      "layout": {
        "ax": "center",
        "ay": "top",
        "px": 8,
        "py": 10.667,
        "w": "stretch",
        "h": 71.111
      }
    },
    {
      "id": "time",
      "metric": "elapsedTime",
      "kind": "stat",
      "visible": true,
      "layout": {
        "ax": "right",
        "ay": "bottom",
        "px": 4,
        "py": 3.556,
        "w": 34,
        "h": 14.222
      }
    }
  ]
}
